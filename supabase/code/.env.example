# Generated by Supabase EasyPanel Pro v4.0
# Template: env.example
# Mode: Analytics Removed
# Google OAuth: Enabled

############
# Secrets
# JEFE: GENERE NUEVAS CLAVES SEGURAS PARA ESTOS VALORES
############

POSTGRES_PASSWORD=tu_password_seguro_postgres
JWT_SECRET=tu_super_secreto_jwt_min_32_chars
# Puedes generar las keys (ANON y SERVICE) usando el JWT_SECRET en herramientas de Supabase
ANON_KEY=tu_anon_key_publica
SERVICE_ROLE_KEY=tu_service_role_key_privada
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=tu_password_dashboard
SECRET_KEY_BASE=tu_secret_key_base_generada
VAULT_ENC_KEY=tu_vault_encryption_key


############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Supavisor -- Database pooler
############
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=tu_tenant_id_generado


############
# API Proxy
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# API
############

PGRST_DB_SCHEMAS=public,storage,graphql_public


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
# JEFE: REEMPLACE 'tu-dominio.com' CON SU DOMINIO REAL (sin https:// al inicio si usa la variable PRIMARY_DOMAIN)
SITE_URL=https://$(PRIMARY_DOMAIN)
ADDITIONAL_REDIRECT_URLS=https://tu-dominio.com
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
# IMPORTANTE: Cambiar esto al dominio real para que Google OAuth funcione
API_EXTERNAL_URL=https://tu-dominio.com

## Mailer Config
# IMPORTANTE: Agregue esta linea para evitar errores de confianza de dominio
GOTRUE_MAILER_EXTERNAL_HOSTS=https://tu-dominio.com

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@tu-dominio.com
SMTP_HOST=smtp.proveedor.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
SMTP_SENDER_NAME=Tu_Nombre_Remitente
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

## Google OAuth
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOTRUE_EXTERNAL_GOOGLE_SECRET=tu_google_client_secret
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://tu-dominio.com/auth/v1/callback


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Tu_Organizacion
STUDIO_DEFAULT_PROJECT=Tu_Proyecto

STUDIO_PORT=3000
# IMPORTANTE: Cambiar al dominio real para acceso externo correcto
SUPABASE_PUBLIC_URL=https://tu-dominio.com

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true

# OpenAI API Key (Opcional)
OPENAI_API_KEY=


############
# Functions
############
FUNCTIONS_VERIFY_JWT=false


############
# Logs
############
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
